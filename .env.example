# Safar backend local/deployment configuration. Replace placeholders in your secret manager.
PORT=5000
# Local development: true runs the worker in-process. Render API must set false;
# its separate background worker runs `npm run worker`.
RUN_NOTIFICATION_WORKER=true
MONGO_URI=mongodb://127.0.0.1:27017/safar?replicaSet=rs0
# Production: exact HTTPS origin(s), comma-separated, with no paths or wildcard.
CORS_ORIGIN=http://localhost:5173
# Production: required even for backend-first rollout because emails contain frontend links.
# Use an explicitly configured temporary HTTPS origin until Vercel is deployed, then update it.
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
# COOKIE_SITE_DOMAIN is required only with production COOKIE_SAME_SITE=lax and must
# contain both frontend and API hosts. It is not needed with SameSite=None.
COOKIE_SITE_DOMAIN=localhost

# Authentication signing secrets: generate independent, random values of at least 32 bytes.
ACCESS_TOKEN_SECRET=replace-with-a-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-refresh-token-secret
# Durations accept strings (15m, 7d) or seconds; access is capped at 15m and
# refresh/inactivity/absolute lifetimes are capped at 7d.
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
REFRESH_TOKEN_INACTIVITY_EXPIRY=7d
REFRESH_SESSION_ABSOLUTE_EXPIRY=7d
JWT_ISSUER=safar-api
JWT_AUDIENCE=safar-frontend
# Production on separate *.vercel.app and *.onrender.com domains needs none;
# production cookies are Secure. Same-site custom subdomains can use lax and
# COOKIE_SITE_DOMAIN. Leave COOKIE_DOMAIN unset for host-only cookies.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=example.com

# Active Razorpay mode requires its KEY_ID, KEY_SECRET, and WEBHOOK_SECRET values.
# Inactive-mode credentials are needed only when switching modes; all names are shown.
# Test and Live use the same payment implementation. Changing the selector requires restart.
RAZORPAY_MODE=test
RAZORPAY_TEST_KEY_ID=replace-with-test-key-id
RAZORPAY_TEST_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_TEST_WEBHOOK_SECRET=replace-with-test-webhook-secret
RAZORPAY_LIVE_KEY_ID=replace-with-live-key-id
RAZORPAY_LIVE_KEY_SECRET=replace-with-live-key-secret
RAZORPAY_LIVE_WEBHOOK_SECRET=replace-with-live-webhook-secret

# Required by the production API and worker. This is a Brevo API key, not an SMTP key.
BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=notifications@example.com
BREVO_SENDER_NAME=Safar

# Optional comma-separated operations inboxes for confirmed-booking notices.
SAFAR_ADMIN_NOTIFICATION_EMAILS=
# Leave COOKIE_DOMAIN unset to use host-only cookies.
