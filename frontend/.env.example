# For local development, Vite proxies /api requests to Express on port 5000.
# For Vercel, set this in the Vercel project environment (preview/staging and
# production separately). This value is public and must end with /api/v1.
# Never put Razorpay API or webhook secrets in frontend variables.
# VITE_API_BASE_URL=https://your-safar-api.example.com/api/v1
